{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posteriq.local/schemas/review.schema.json",
  "title": "PosterIQ Review",
  "description": "Structured output for a PosterIQ research poster review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "poster_id",
    "summary",
    "findings",
    "mockup_changes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "poster_id": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview",
        "strengths",
        "top_priorities",
        "assessment_limitations"
      ],
      "properties": {
        "overview": {
          "type": "string",
          "description": "Concise overall assessment of the poster."
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "top_priorities": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "assessment_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Uncertain or unreadable evidence that prevents a reliable assessment; not recommendations."
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "maxItems": 12
    },
    "mockup_changes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_index",
          "block_id",
          "suggested_text",
          "font_scale",
          "improve_contrast",
          "reason"
        ],
        "properties": {
          "finding_index": {
            "type": "integer",
            "minimum": 0
          },
          "block_id": {
            "type": "integer"
          },
          "suggested_text": {
            "type": "string"
          },
          "font_scale": {
            "type": "number",
            "minimum": 1,
            "maximum": 1.35
          },
          "improve_contrast": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "priority",
        "finding",
        "evidence",
        "recommendation",
        "guidance",
        "kind",
        "confidence",
        "impact"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "scientific_content",
            "statistics",
            "visual_design",
            "readability",
            "accessibility",
            "required_elements"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "finding": {
          "type": "string",
          "description": "A demonstrated poster-specific problem or meaningful optional refinement. Do not criticize acceptable sections."
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "evidence_type",
            "section",
            "page_number",
            "block_ids"
          ],
          "properties": {
            "description": {
              "type": "string",
              "description": "Poster-specific evidence supporting the finding."
            },
            "evidence_type": {
              "type": "string",
              "enum": [
                "text",
                "table",
                "layout",
                "visual",
                "multiple"
              ]
            },
            "section": {
              "type": [
                "string",
                "null"
              ]
            },
            "page_number": {
              "type": [
                "integer",
                "null"
              ]
            },
            "block_ids": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        },
        "recommendation": {
          "type": "string",
          "description": "Concrete action the poster author can take."
        },
        "guidance": {
          "$ref": "#/$defs/guidance"
        },
        "kind": {
          "type": "string",
          "enum": [
            "issue",
            "optional_refinement"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Include only high-confidence findings; omit uncertain claims."
        },
        "impact": {
          "type": "string",
          "description": "Specific consequence for reader understanding or accessibility that justifies changing this poster."
        }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source",
        "section",
        "reference_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "curated_standard",
            "general_suggestion"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
